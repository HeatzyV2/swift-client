# Launcher build-time settings — copy to src-tauri/.env (injected via build.rs).
# Every value below ends up readable in the shipped binary, so nothing secret
# belongs in here.

# Discord application id for Rich Presence. Public by design; leave empty to
# build without Discord status.
DISCORD_CLIENT_ID=

# Base URL of the Swift Client online service (https only), e.g.
# https://api.swiftclient.example. It powers CurseForge (the API key lives on
# the server) and instance sharing by code. Leave empty to build without them:
# the launcher then makes no request to any Swift server.
SWIFT_BACKEND_URL=