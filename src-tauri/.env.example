# Launcher build-time settings — copy to src-tauri/.env (injected via build.rs).
# Every value below ends up readable in the shipped binary, so nothing secret
# belongs in here.

# Discord application id for Rich Presence. Public by design; leave empty to
# build without Discord status.
DISCORD_CLIENT_ID=

# Base URL of the Swift Client online service. Must be https:// (passwords and
# chat go through it); plain http:// is only accepted for localhost/127.0.0.1.
# Powers CurseForge proxy, instance sharing, and remote Social.
SWIFT_BACKEND_URL=https://api.swiftclient.fr
