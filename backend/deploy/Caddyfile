# HTTPS in front of the Swift Client backend.
#
# Runs on the machine that hosts the Pterodactyl node (it needs ports 80 and 443).
# Caddy gets and renews the Let's Encrypt certificate on its own.
# Replace 127.0.0.1:10049 with the IP:port of the backend's allocation.

api.swiftclient.fr {
	encode gzip

	# Share packs and chat images go through here
	request_body {
		max_size 512MB
	}

	reverse_proxy 127.0.0.1:10049 {
		header_up X-Forwarded-Proto https
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
}
