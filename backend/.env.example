# Swift Client online service — copy to .env on the host

# Pterodactyl uses SERVER_PORT; locally you can set PORT
# SERVER_PORT=
PORT=8787
HOST=0.0.0.0

# Must match the public address clients use to reach this server
PUBLIC_URL=https://api.swiftclient.fr
SHARE_PUBLIC_URL=swift://share
DATA_DIR=./data
JWT_SECRET=change-me-to-a-long-random-string

# Optional — without it, /api/curseforge returns 501
CURSEFORGE_API_KEY=

MEDIA_TTL_DAYS=7
SHARE_TTL_DAYS=30
CLEANUP_INTERVAL_MS=3600000

# World hosting relay (Swift Client "Host World"). Every port must be a Pterodactyl allocation.
# RELAY_PORT=10050
# RELAY_PORT_MIN=10051
# RELAY_PORT_MAX=10060
# Players join <pseudo>.swiftclient.fr: wildcard DNS *.swiftclient.fr -> this server (see README)
# RELAY_GATEWAY_PORT=25565
# RELAY_DOMAIN=swiftclient.fr

# --- Swift Platform (admin panel, /api/v1) -----------------------------------------------------
# Full list with defaults: docs/ENVIRONMENT.md
APP_ENV=production
ADMIN_PUBLIC_URL=https://admin.swiftclient.fr
# CDN_BASE_URL=https://cdn.swiftclient.fr
DOWNLOAD_BASE_URL=https://download.swiftclient.fr
# ACCESS_TOKEN_TTL_SEC=900
# LOGIN_MAX_FAILURES=5
# RATE_LIMIT_DEFAULT=300
# ANALYTICS_RETENTION_DAYS=90
# TRUST_PROXY=auto
# LOG_LEVEL=info
